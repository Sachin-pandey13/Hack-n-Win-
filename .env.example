# ===========================================
# CodeElysium Environment Variables
# Copy this to .env.local and fill in values
# ===========================================

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=codeelysium

# Firebase (Client-side — must be NEXT_PUBLIC_)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MSG_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Judge0 (Code Execution)
# Option A: RapidAPI hosted Judge0
RAPIDAPI_KEY=

# Option B: Self-hosted Judge0
# JUDGE0_URL=http://your-judge0-instance:2358

# OpenAI (Code Analysis & Complexity)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Groq (optional, for backend AI features)
GROQ_API_KEY=
