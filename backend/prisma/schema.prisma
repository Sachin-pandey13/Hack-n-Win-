datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Platform {
  id       String    @id @default(uuid())
  name     String    @unique
  problems Problem[]
}

model Problem {
  id              String            @id @default(uuid())
  platformId      String
  platform        Platform          @relation(fields: [platformId], references: [id])
  title           String
  slug String? @unique
  difficulty      String
  statement       String
  constraints     String
  category        String
  acceptance      Float
  testCases       TestCase[]
  tags            ProblemTag[]
  languages       ProblemLanguage[]
  optimalSolution OptimalSolution?
}

model TestCase {
  id        String   @id @default(uuid())
  problemId String
  problem   Problem  @relation(fields: [problemId], references: [id])
  input     String
  output    String
}

model Tag {
  id       String       @id @default(uuid())
  name     String       @unique
  problems ProblemTag[]
}

model ProblemTag {
  id        String   @id @default(uuid())
  problemId String
  tagId     String
  problem   Problem  @relation(fields: [problemId], references: [id])
  tag       Tag      @relation(fields: [tagId], references: [id])
}

model Language {
  id       String          @id @default(uuid())
  name     String          @unique
  problems ProblemLanguage[]
}

model ProblemLanguage {
  id         String   @id @default(uuid())
  problemId  String
  languageId String
  problem    Problem  @relation(fields: [problemId], references: [id])
  language   Language @relation(fields: [languageId], references: [id])
}

model OptimalSolution {
  id              String   @id @default(uuid())
  problemId       String   @unique
  problem         Problem  @relation(fields: [problemId], references: [id])
  timeComplexity  String
  spaceComplexity String
  explanation     String
}
